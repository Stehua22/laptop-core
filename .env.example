# Supabase — Project Settings → API Keys in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New projects: use the Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
# Legacy projects only (optional fallback):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
# Server-side only — Secret key (sb_secret_...) or legacy service_role key
SUPABASE_SECRET_KEY=your-secret-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# eBay Developer — https://developer.ebay.com (Production app keys)
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret

# Deal scanner protection secret
DEAL_SCAN_SECRET=lapcore-scan-2026
NEXT_PUBLIC_DEAL_SCAN_SECRET=lapcore-scan-2026
