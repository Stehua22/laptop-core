.launcher {
  position: fixed;
  bottom: 24px;
  right: 24px;
  width: 160px;
  height: 48px;
  border-radius: 10px;
  border: none;
  background: var(--accent-color, #2563eb);
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  font-family: 'Inter', sans-serif;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  z-index: 2147483647;
}

.panel {
  position: fixed;
  bottom: 92px;
  right: 24px;
  width: 340px;
  max-width: calc(100vw - 32px);
  height: 460px;
  max-height: calc(100vh - 140px);
  display: flex;
  flex-direction: column;
  background: var(--bg-primary, #fff);
  color: var(--text-primary, #111);
  border-radius: 14px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  overflow: hidden;
  z-index: 1000;
  font-family: 'Inter', sans-serif;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: var(--accent-color, #2563eb);
  color: #fff;
  font-weight: 600;
}

.closeBtn {
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  font-size: 16px;
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.userMsg {
  align-self: flex-end;
  background: var(--accent-color, #2563eb);
  color: #fff;
  padding: 8px 12px;
  border-radius: 12px 12px 2px 12px;
  max-width: 80%;
  font-size: 14px;
  white-space: pre-wrap;
}

.assistantMsg {
  align-self: flex-start;
  background: var(--bg-secondary, #f1f1f1);
  color: var(--text-primary, #111);
  padding: 8px 12px;
  border-radius: 12px 12px 12px 2px;
  max-width: 80%;
  font-size: 14px;
  white-space: pre-wrap;
}

.inputRow {
  display: flex;
  gap: 8px;
  padding: 10px;
  border-top: 1px solid var(--border-color, #e5e5e5);
}

.input {
  flex: 1;
  resize: none;
  border: 1px solid var(--border-color, #e5e5e5);
  border-radius: 8px;
  padding: 8px 10px;
  font-size: 14px;
  font-family: inherit;
  background: var(--bg-primary, #fff);
  color: var(--text-primary, #111);
}

.sendBtn {
  border: none;
  background: var(--accent-color, #2563eb);
  color: #fff;
  padding: 0 14px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
}

.sendBtn:disabled {
  opacity: 0.6;
  cursor: default;
}